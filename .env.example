# Required for itinerary generation
ANTHROPIC_API_KEY=

# Required for real flight pricing (free at https://developers.amadeus.com)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# Set to "true" for production Amadeus data (default is test/sandbox)
AMADEUS_PRODUCTION=false

# Optional
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
